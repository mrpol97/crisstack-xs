{
  "name": "cinestack",
  "version": "0.2.0",
  "description": "CrisStack XS: offload verificado, biblioteca de clips, color, audio, informes y exportaciones para DIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "local.crisstack.xs",
    "productName": "CrisStack XS",
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dmg"
      ],
      "identity": null,
      "hardenedRuntime": false
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "xxhash-wasm": "^1.1.0"
  },
  "devDependencies": {
    "electron-builder": "^26.18.0",
    "electron": "^45.2.1"
  },
  "author": {
    "name": "mrpol97",
    "email": "mrpol97@gmail.com"
  },
  "homepage": "https://github.com/mrpol97/crisstack-xs"
}
